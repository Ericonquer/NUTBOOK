{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nutbook Motion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "pages"
  ],
  "properties": {
    "contract": {
      "const": "nutbook-motion/v1"
    },
    "pages": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capabilities",
          "targets",
          "actions",
          "background",
          "transition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:-]{1,80}$"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "containsVideo",
              "containsEmbeddedFrame",
              "supportsDomTransition",
              "supportsFilterTransition",
              "mediaTargetIds",
              "embeddedTargetIds"
            ],
            "properties": {
              "containsVideo": {
                "type": "boolean"
              },
              "containsEmbeddedFrame": {
                "type": "boolean"
              },
              "supportsDomTransition": {
                "type": "boolean"
              },
              "supportsFilterTransition": {
                "type": "boolean"
              },
              "mediaTargetIds": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                },
                "uniqueItems": true
              },
              "embeddedTargetIds": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                },
                "uniqueItems": true
              }
            }
          },
          "targets": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                },
                "kind": {
                  "enum": [
                    "text",
                    "image",
                    "group",
                    "video",
                    "embedded"
                  ]
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "targetId",
                "templateId",
                "templateVersion",
                "params",
                "seed",
                "trigger",
                "delayMs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                },
                "targetId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                },
                "templateId": {
                  "enum": [
                    "text.glyph-particles",
                    "entrance.gravity-impact",
                    "emphasis.spotlight",
                    "exit.particle-dissolve"
                  ]
                },
                "templateVersion": {
                  "const": 1
                },
                "params": {
                  "type": "object"
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "trigger": {
                  "enum": [
                    "click",
                    "withPrevious",
                    "afterPrevious"
                  ]
                },
                "delayMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60000
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "templateId": {
                        "const": "text.glyph-particles"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "params": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "durationMs",
                          "strength",
                          "density"
                        ],
                        "properties": {
                          "durationMs": {
                            "type": "number",
                            "minimum": 500,
                            "maximum": 6000
                          },
                          "strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2
                          },
                          "density": {
                            "type": "integer",
                            "minimum": 12,
                            "maximum": 400
                          },
                          "hue": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 360
                          },
                          "colorMode": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2
                          },
                          "lightness": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "templateId": {
                        "const": "entrance.gravity-impact"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "params": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "durationMs",
                          "strength"
                        ],
                        "properties": {
                          "durationMs": {
                            "type": "number",
                            "minimum": 500,
                            "maximum": 6000
                          },
                          "strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2
                          },
                          "dustSize": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 3
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "templateId": {
                        "const": "emphasis.spotlight"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "params": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "durationMs",
                          "strength"
                        ],
                        "properties": {
                          "durationMs": {
                            "type": "number",
                            "minimum": 500,
                            "maximum": 6000
                          },
                          "strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "templateId": {
                        "const": "exit.particle-dissolve"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "params": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "durationMs",
                          "strength",
                          "density"
                        ],
                        "properties": {
                          "durationMs": {
                            "type": "number",
                            "minimum": 500,
                            "maximum": 6000
                          },
                          "strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2
                          },
                          "density": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 2400
                          },
                          "hue": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 360
                          },
                          "colorMode": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2
                          },
                          "lightness": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "background": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "templateId",
                  "templateVersion",
                  "params",
                  "seed"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                  },
                  "templateId": {
                    "const": "background.flowing-gradient"
                  },
                  "templateVersion": {
                    "const": 1
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "durationMs",
                      "strength",
                      "hue",
                      "hue2",
                      "speed",
                      "scale"
                    ],
                    "properties": {
                      "durationMs": {
                        "type": "number",
                        "minimum": 6000,
                        "maximum": 30000
                      },
                      "strength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.65
                      },
                      "hue": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "hue2": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 2
                      },
                      "scale": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      }
                    }
                  }
                }
              }
            ]
          },
          "transition": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "templateId",
                  "templateVersion",
                  "params",
                  "seed"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,80}$"
                  },
                  "templateId": {
                    "const": "transition.curtain-reveal"
                  },
                  "templateVersion": {
                    "const": 1
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "durationMs",
                      "direction",
                      "shape",
                      "feather"
                    ],
                    "properties": {
                      "durationMs": {
                        "type": "number",
                        "minimum": 300,
                        "maximum": 2000
                      },
                      "direction": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "shape": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "feather": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.3
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}
