{
  "name": "nutbook",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "vite build --config vite.config.mjs && node scripts/patch-markdown-editor-bundle.mjs",
    "check:frontend": "node --check dist/assets/markdown-editor.js",
    "check:regressions": "node scripts/test-html-edit-image-acceptance-artifact.mjs && node scripts/test-regressions.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@milkdown/kit": "^7.15.3",
    "prosemirror-tables": "^1.8.1"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
